---
interface Props { text: string; }
const { text } = Astro.props;
---
<div class="marquee" aria-hidden="true">
  <span class="marquee-track">
    <span class="marquee-content">{text}</span>
    <span class="marquee-content">INSERT COIN</span>
    <span class="marquee-content">{text}</span>
    <span class="marquee-content">INSERT COIN</span>
  </span>
</div>

<style>
.marquee {
  background: linear-gradient(90deg, var(--violet), var(--cyan), var(--pink), var(--violet));
  background-size: 300% 100%;
  animation: marquee-colors 4s linear infinite;
  padding: 8px 0;
  overflow: hidden;
  font-size: 8px;
  letter-spacing: 2px;
  color: #000;
  font-weight: bold;
}

.marquee-track {
  display: inline-flex;
  gap: 6rem;
  white-space: nowrap;
  animation: marquee-scroll 12s linear infinite;
}

.marquee-content {
}

@keyframes marquee-colors {
  0%   { background-position: 0% 50%; }
  100% { background-position: 100% 50%; }
}

@keyframes marquee-scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

@media (prefers-reduced-motion: reduce) {
  .marquee { animation: none; background: var(--violet); color: var(--white); }
  .marquee-track { animation: none; }
}
</style>
