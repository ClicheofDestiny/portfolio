---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.published);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} screenTitle={`STAGE ${String(post.data.stage).padStart(2,'0')}`}>
  <button class="popout-btn text-xxs" id="popout-btn" aria-label="Open in fullscreen modal">⊞</button>

  <div class="post-header">
    <h1 class="page-title text-md glow-cyan">{post.data.title.toUpperCase()}</h1>
    <div class="post-meta text-xxs">
      <span class="glow-violet">{post.data.category.toUpperCase()}</span>
      <span class="meta-dim"> · {post.data.date.toISOString().slice(0,10)}</span>
      <span class="glow-gold"> · +{post.data.xp} XP</span>
    </div>
  </div>

  <div class="post-body" id="post-body">
    <Content />
  </div>

  <a href="/writing" class="back-link text-xxs">← BACK TO LEVEL SELECT</a>
</BaseLayout>

<!-- Modal lives at body level so it can escape the cabinet -->
<div class="post-modal" id="post-modal" aria-modal="true" role="dialog" aria-label="{post.data.title}" hidden>
  <div class="modal-backdrop" id="modal-backdrop"></div>
  <div class="modal-window">
    <div class="modal-chrome">
      <div class="modal-meta text-xxs">
        <span class="glow-violet">{post.data.category.toUpperCase()}</span>
        <span class="meta-dim"> · {post.data.date.toISOString().slice(0,10)}</span>
        <span class="glow-gold"> · +{post.data.xp} XP</span>
      </div>
      <button class="modal-close text-xxs glow-pink" id="modal-close" aria-label="Close modal">✕ CLOSE</button>
    </div>
    <h2 class="modal-title text-lg glow-cyan">{post.data.title.toUpperCase()}</h2>
    <div class="modal-body" id="modal-body"></div>
  </div>
</div>

<script>
  function setupModal() {
    const openBtn   = document.getElementById('popout-btn');
    const modal     = document.getElementById('post-modal');
    const closeBtn  = document.getElementById('modal-close');
    const backdrop  = document.getElementById('modal-backdrop');
    const modalBody = document.getElementById('modal-body');
    const source    = document.getElementById('post-body');

    if (!openBtn || !modal || !closeBtn || !backdrop || !modalBody || !source) return;

    function openModal(pushState = true) {
      modalBody.innerHTML = '';
      modalBody.appendChild(source.cloneNode(true));
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
      if (pushState) {
        const url = new URL(location.href);
        url.searchParams.set('view', 'full');
        history.pushState({ modal: true }, '', url);
      }
    }

    function closeModal(pushState = true) {
      modal.hidden = true;
      document.body.style.overflow = '';
      openBtn.focus();
      if (pushState) {
        const url = new URL(location.href);
        url.searchParams.delete('view');
        history.pushState({ modal: false }, '', url);
      }
    }

    if (new URL(location.href).searchParams.get('view') === 'full') {
      openModal(false);
    }

    window.addEventListener('popstate', (e) => {
      if (e.state?.modal) openModal(false);
      else closeModal(false);
    });

    openBtn.addEventListener('click', () => openModal());
    closeBtn.addEventListener('click', () => closeModal());
    backdrop.addEventListener('click', () => closeModal());
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) closeModal(); });
  }

  document.addEventListener('astro:page-load', setupModal);
</script>

<style>
/* ── Popout button ─────────────────────────────────────────── */
.popout-btn {
  position: absolute;
  top: clamp(6px, 1.6cqi, 14px);
  right: clamp(6px, 1.6cqi, 14px);
  z-index: 10;
  background: rgba(123, 47, 255, 0.1);
  border: 1px solid rgba(123, 47, 255, 0.4);
  color: var(--violet);
  padding: 4px 7px;
  border-radius: 3px;
  cursor: pointer;
  font-family: var(--font-pixel);
  font-size: clamp(7px, 1.4cqi, 13px);
  line-height: 1;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
}
.popout-btn:hover, .popout-btn:focus-visible {
  background: rgba(123, 47, 255, 0.25);
  color: var(--white);
  border-color: var(--violet);
  outline: none;
}

/* ── Post content (inline) ─────────────────────────────────── */
.post-header { margin-bottom: 16px; }
.page-title { margin-bottom: 6px; }
.post-meta { margin-bottom: 0; }
.meta-dim { color: var(--dim); }

.post-body {
  font-family: var(--font-terminal);
  font-size: clamp(15px, 3.4cqi, 30px);
  line-height: 1.25;
  letter-spacing: 0.02em;
  color: var(--white);
  opacity: 0.95;
}
.post-body :global(h2) {
  font-family: var(--font-pixel);
  color: var(--cyan);
  font-size: clamp(9px, 2.2cqi, 22px);
  line-height: 1.5;
  margin: clamp(14px, 4cqi, 32px) 0 clamp(6px, 1.6cqi, 14px);
}
.post-body :global(h3) {
  font-family: var(--font-pixel);
  color: var(--violet);
  font-size: clamp(8px, 1.9cqi, 18px);
  line-height: 1.5;
  margin: clamp(10px, 3cqi, 24px) 0 clamp(4px, 1.2cqi, 10px);
}
.post-body :global(p)  { margin-bottom: clamp(8px, 2.4cqi, 20px); }
.post-body :global(code) {
  background: rgba(47,255,255,0.06);
  border: 1px solid rgba(47,255,255,0.15);
  padding: 0 6px;
  border-radius: 2px;
  font-family: var(--font-terminal);
  font-size: 1em;
}
.post-body :global(pre) {
  background: rgba(0,0,0,0.4);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: clamp(8px, 2.4cqi, 20px);
  overflow-x: auto;
  margin-bottom: clamp(8px, 2.4cqi, 20px);
}
.post-body :global(pre code) { background: none; border: none; padding: 0; }
.post-body :global(img) { width: 100%; border-radius: 4px; margin-bottom: 12px; }

.back-link { color: var(--violet); display: inline-block; margin-top: 20px; }

/* ── Modal ─────────────────────────────────────────────────── */
.post-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 16px;
}
.post-modal[hidden] { display: none; }

.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(9, 7, 31, 0.85);
  backdrop-filter: blur(4px);
}

.modal-window {
  position: relative;
  z-index: 1;
  background: #00000f;
  border: 2px solid var(--violet);
  border-radius: 6px;
  box-shadow:
    0 0 0 1px rgba(123,47,255,0.3),
    0 0 60px rgba(123,47,255,0.2),
    0 0 120px rgba(47,255,255,0.08);
  width: min(760px, 100%);
  max-height: calc(100dvh - 48px);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-chrome {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  border-bottom: 1px solid var(--border);
  background: rgba(123,47,255,0.06);
  flex-shrink: 0;
}

.modal-meta { color: var(--dim); }

.modal-close {
  background: none;
  border: 1px solid rgba(255,47,170,0.4);
  color: var(--pink);
  font-family: var(--font-pixel);
  font-size: 6px;
  padding: 4px 8px;
  border-radius: 3px;
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
}
.modal-close:hover, .modal-close:focus-visible {
  background: rgba(255,47,170,0.15);
  border-color: var(--pink);
  outline: none;
}

.modal-title {
  padding: 16px 20px 8px;
  flex-shrink: 0;
}

.modal-body {
  overflow-y: auto;
  padding: 16px 28px 32px;
  flex: 1;
}

/* Body content inside modal — larger, more readable */
.modal-body :global(.post-body) {
  font-size: clamp(17px, 2vw, 24px);
  line-height: 1.4;
  opacity: 1;
}
.modal-body :global(.post-body h2) { font-size: clamp(10px, 1.2vw, 16px); }
.modal-body :global(.post-body h3) { font-size: clamp(9px, 1.1vw, 14px); }
</style>
