---
import { ClientRouter } from 'astro:transitions';
import Marquee from '../components/Marquee.astro';
import CabinetControls from '../components/CabinetControls.astro';
import { siteConfig } from '../config/site';
import KonamiListener from '../components/KonamiListener.vue';
import '../styles/global.css';
import '../styles/crt.css';
import '../styles/typography.css';
import '../styles/transitions.css';

interface Props {
  title: string;
  screenTitle?: string;
}
const { title, screenTitle } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | {siteConfig.name}</title>
  <ClientRouter />
</head>
<body>
  <KonamiListener client:load>
  <div class="cabinet">
    <div class="cabinet-header" aria-hidden="true">
      <svg class="cabinet-title" viewBox="0 0 775 130" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="title-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%"   stop-color="#09071f"/>
            <stop offset="45%"   stop-color="#09071f"/>
            <stop offset="55%"  stop-color="#33284a"/>
            <stop offset="70%"  stop-color="#8fa8cc"/>
            <stop offset="100%" stop-color="#c8daf2"/>
          </linearGradient>
          <radialGradient id="title-stroke" cx="50%" cy="50%" r="50%" fx="50%" fy="50%">
            <stop offset="0%"   stop-color="#cc2200"/>
            <stop offset="10%" stop-color="#ddafd3"/>
            <stop offset="20%" stop-color="#cc2200"/>
            <stop offset="50%" stop-color="#ddafd3"/>
            <stop offset="60%" stop-color="#cc2200"/>
            <stop offset="90%" stop-color="#ddafd3"/>
            <stop offset="100%" stop-color="#b94741"/>
          </linearGradient>
        </defs>
        <!-- crosshair centred on S -->
        <line x1="338" y1="-20" x2="338" y2="150" stroke="#00bb33" stroke-width="1"/>
        <line x1="-20" y1="67"  x2="795" y2="67"  stroke="#00bb33" stroke-width="1"/>
        <text
          x="50%" y="90%"
          text-anchor="middle"
          font-family="TRON, Orbitron, sans-serif"
          font-size="100"
          font-weight="900"
          letter-spacing="4"
          fill="url(#title-fill)"
          stroke="url(#title-stroke)"
          stroke-width="8"
          paint-order="stroke fill"
        >{siteConfig.name.split(' ')[0].toUpperCase()}</text>
      </svg>
    </div>
    <Marquee text={siteConfig.marquee} />

    <div class="bezel">
      {screenTitle && (
        <div class="screen-title text-xxs label glow-violet">{screenTitle}</div>
      )}
      <div class="screen crt screen-glow" transition:name="main-screen" transition:animate="none">
        <div class="screen-inner">
          <slot />
        </div>
      </div>
    </div>

    <CabinetControls />

    <div class="coin-slot text-xxs label">— INSERT COIN TO CONTINUE —</div>
  </div>
  </KonamiListener>
</body>
</html>

<style>
.cabinet-header {
  background: #0a0a0a;
  border-bottom: 2px solid #1a1a1a;
  padding: 0;
  position: relative;
}
.cabinet-header::before,
.cabinet-header::after {
  content: '';
  position: absolute;
  left: 6%;
  right: 6%;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--white), transparent);
  opacity: 0.5;
}
.cabinet-header::before { top: 5px; }
.cabinet-header::after  { bottom: 5px; }
.cabinet-title {
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;
}
.cabinet {
  width: 100%;
  /* Mobile: fills available width. Desktop+: grows from 600px to 960px. */
  max-width: min(100%, clamp(600px, 50vw, 960px));
  background: linear-gradient(160deg, var(--chrome) 0%, var(--bezel) 50%, var(--cabinet) 100%);
  border-radius: 18px 18px 8px 8px;
  border: 2px solid var(--border);
  box-shadow:
    0 0 0 1px rgba(123,45,255,0.3),
    0 0 40px rgba(47,255,255,0.1),
    0 0 80px rgba(123,45,255,0.08);
  overflow: hidden;
}
.bezel {
  padding: clamp(8px, 2vw, 14px);
  background: var(--bezel);
  border-bottom: 2px solid var(--border);
}
.screen-title {
  color: var(--violet);
  margin-bottom: 6px;
}
.screen {
  background: #00000f;
  border-radius: 5px;
  border: 2px solid #111130;
  min-height: clamp(260px, 45vh, 520px);
}
.screen-inner {
  padding: clamp(12px, 3vw, 36px) clamp(10px, 2.5vw, 32px);
  position: relative;
  z-index: 2;
}
.coin-slot {
  text-align: center;
  padding: 8px;
  color: var(--dim);
  border-top: 1px solid var(--border);
}

@media (max-width: 479px) {
  .cabinet { border-radius: 10px 10px 4px 4px; }
}

</style>
